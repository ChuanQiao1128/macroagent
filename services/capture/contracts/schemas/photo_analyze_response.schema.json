{
  "$defs": {
    "ClarifyQuestion": {
      "additionalProperties": false,
      "properties": {
        "question_id": {
          "minLength": 1,
          "title": "Question Id",
          "type": "string"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "question_id",
        "text"
      ],
      "title": "ClarifyQuestion",
      "type": "object"
    },
    "NutritionInterval": {
      "additionalProperties": false,
      "properties": {
        "best_estimate": {
          "minimum": 0,
          "title": "Best Estimate",
          "type": "number"
        },
        "max_estimate": {
          "minimum": 0,
          "title": "Max Estimate",
          "type": "number"
        },
        "min_estimate": {
          "minimum": 0,
          "title": "Min Estimate",
          "type": "number"
        },
        "source": {
          "minLength": 1,
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "best_estimate",
        "min_estimate",
        "max_estimate",
        "source"
      ],
      "title": "NutritionInterval",
      "type": "object"
    },
    "NutritionIntervals": {
      "additionalProperties": false,
      "properties": {
        "carbs_g": {
          "$ref": "#/$defs/NutritionInterval"
        },
        "fat_g": {
          "$ref": "#/$defs/NutritionInterval"
        },
        "fiber_g": {
          "$ref": "#/$defs/NutritionInterval"
        },
        "kcal": {
          "$ref": "#/$defs/NutritionInterval"
        },
        "protein_g": {
          "$ref": "#/$defs/NutritionInterval"
        },
        "sodium_mg": {
          "$ref": "#/$defs/NutritionInterval"
        },
        "sugar_g": {
          "$ref": "#/$defs/NutritionInterval"
        }
      },
      "required": [
        "kcal",
        "protein_g",
        "carbs_g",
        "fat_g",
        "sugar_g",
        "sodium_mg",
        "fiber_g"
      ],
      "title": "NutritionIntervals",
      "type": "object"
    },
    "UncertaintySummary": {
      "additionalProperties": false,
      "properties": {
        "confidence_label": {
          "enum": [
            "high",
            "medium",
            "low"
          ],
          "title": "Confidence Label",
          "type": "string"
        },
        "relative_range_width": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Relative Range Width"
        },
        "uncertainty_flags": {
          "items": {
            "type": "string"
          },
          "title": "Uncertainty Flags",
          "type": "array"
        }
      },
      "required": [
        "confidence_label"
      ],
      "title": "UncertaintySummary",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "clarify_questions": {
      "items": {
        "$ref": "#/$defs/ClarifyQuestion"
      },
      "title": "Clarify Questions",
      "type": "array"
    },
    "ledger_entry_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Ledger Entry Id"
    },
    "nutrition": {
      "anyOf": [
        {
          "$ref": "#/$defs/NutritionIntervals"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "reasons": {
      "items": {
        "type": "string"
      },
      "title": "Reasons",
      "type": "array"
    },
    "request_id": {
      "minLength": 1,
      "title": "Request Id",
      "type": "string"
    },
    "status": {
      "enum": [
        "ACCEPT",
        "WARN",
        "CLARIFY",
        "BLOCK"
      ],
      "title": "Status",
      "type": "string"
    },
    "trace_id": {
      "minLength": 1,
      "title": "Trace Id",
      "type": "string"
    },
    "uncertainty_summary": {
      "$ref": "#/$defs/UncertaintySummary"
    }
  },
  "required": [
    "request_id",
    "status",
    "trace_id",
    "uncertainty_summary"
