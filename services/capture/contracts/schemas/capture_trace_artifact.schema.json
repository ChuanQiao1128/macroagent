{
  "$defs": {
    "CaptureQualitySummary": {
      "additionalProperties": false,
      "properties": {
        "arkit_confidence_coverage": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Arkit Confidence Coverage"
        },
        "arkit_depth_available": {
          "default": false,
          "title": "Arkit Depth Available",
          "type": "boolean"
        },
        "arkit_depth_map_height_px": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Arkit Depth Map Height Px"
        },
        "arkit_depth_map_width_px": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Arkit Depth Map Width Px"
        },
        "arkit_depth_quality": {
          "default": "none",
          "enum": [
            "none",
            "low",
            "medium",
            "high",
            "unknown"
          ],
          "title": "Arkit Depth Quality",
          "type": "string"
        },
        "arkit_scene_depth_supported": {
          "default": false,
          "title": "Arkit Scene Depth Supported",
          "type": "boolean"
        },
        "arkit_smoothed_scene_depth_supported": {
          "default": false,
          "title": "Arkit Smoothed Scene Depth Supported",
          "type": "boolean"
        },
        "camera_intrinsics_available": {
          "default": false,
          "title": "Camera Intrinsics Available",
          "type": "boolean"
        },
        "camera_position": {
          "enum": [
            "front",
            "back",
            "unknown"
          ],
          "title": "Camera Position",
          "type": "string"
        },
        "depth_available": {
          "title": "Depth Available",
          "type": "boolean"
        },
        "depth_quality": {
          "enum": [
            "none",
            "low",
            "medium",
            "high",
            "unknown"
          ],
          "title": "Depth Quality",
          "type": "string"
        },
        "food_volume_estimate_confidence": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Food Volume Estimate Confidence"
        },
        "food_volume_estimate_method": {
          "anyOf": [
            {
              "enum": [
                "arkit_depth_region",
                "manual_container",
                "recipe_template"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Food Volume Estimate Method"
        },
        "food_volume_estimate_ml_p10": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Food Volume Estimate Ml P10"
        },
        "food_volume_estimate_ml_p50": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Food Volume Estimate Ml P50"
        },
        "food_volume_estimate_ml_p90": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Food Volume Estimate Ml P90"
        },
        "lens_hint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lens Hint"
        },
        "lidar_available": {
          "title": "Lidar Available",
          "type": "boolean"
        },
        "orientation": {
          "enum": [
            "portrait",
            "portrait_upside_down",
            "landscape_left",
            "landscape_right",
            "face_up",
            "face_down",
            "unknown"
          ],
          "title": "Orientation",
          "type": "string"
        },
        "pitch_degrees": {
          "maximum": 180,
          "minimum": -180,
          "title": "Pitch Degrees",
          "type": "number"
        },
        "roll_degrees": {
          "maximum": 180,
          "minimum": -180,
          "title": "Roll Degrees",
          "type": "number"
        }
      },
      "required": [
        "depth_available",
        "depth_quality",
        "lidar_available",
        "camera_position",
        "orientation",
        "pitch_degrees",
        "roll_degrees"
      ],
      "title": "CaptureQualitySummary",
      "type": "object"
    },
    "ImageIdentity": {
      "additionalProperties": false,
      "properties": {
        "byte_size": {
          "exclusiveMinimum": 0,
          "title": "Byte Size",
          "type": "integer"
        },
        "height_px": {
          "exclusiveMinimum": 0,
          "title": "Height Px",
          "type": "integer"
        },
        "image_format": {
          "enum": [
            "jpeg",
            "jpg",
            "heic",
            "heif",
            "png",
            "webp"
          ],
          "title": "Image Format",
          "type": "string"
        },
        "image_sha256": {
          "pattern": "^[A-Fa-f0-9]{64}$",
          "title": "Image Sha256",
          "type": "string"
        },
        "width_px": {
          "exclusiveMinimum": 0,
          "title": "Width Px",
          "type": "integer"
        }
      },
      "required": [
        "image_sha256",
        "image_format",
        "width_px",
        "height_px",
        "byte_size"
      ],
      "title": "ImageIdentity",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "barcode_detected": {
      "title": "Barcode Detected",
      "type": "boolean"
    },
    "barcode_value": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Barcode Value"
    },
    "barcode_value_stored": {
      "title": "Barcode Value Stored",
      "type": "boolean"
    },
    "capture_quality_summary": {
      "$ref": "#/$defs/CaptureQualitySummary"
    },
    "image_identity": {
      "$ref": "#/$defs/ImageIdentity"
    },
    "model_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model Version"
    },
    "ocr_detected": {
      "title": "Ocr Detected",
      "type": "boolean"
    },
    "ocr_text_stored": {
      "title": "Ocr Text Stored",
      "type": "boolean"
    },
    "prompt_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Prompt Version"
    },
    "scale_evidence_ids": {
      "items": {
        "type": "string"
      },
      "title": "Scale Evidence Ids",
      "type": "array"
    }
  },
  "required": [
    "image_identity",
    "capture_quality_summary",
    "barcode_detected",
    "barcode_value_stored",
    "ocr_detected",
    "ocr_text_stored"
  ],
  "title": "CaptureTraceArtifact",
  "type": "object"
}
